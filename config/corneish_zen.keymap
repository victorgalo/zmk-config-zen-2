#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_6col_layout;

        // zmk,matrix_transform = &five_column_transform;
    };
};


/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD0";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        bhm: balanced_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <2000>;
            quick-release;
            ignore-modifiers;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <22 23>;
        };

        alt_enter {
            bindings = <&kp ENTER>;
            key-positions = <22 21>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   | 
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB   &kp Q          &kp W        &kp E                &kp R        &kp T          &kp Y       &kp U        &kp I                &kp O        &kp P             &kp BSPC
&skq RALT  &bhm LSHIFT A  &bhm LGUI S  &bhm LEFT_CONTROL D  &bhm LALT F  &kp G          &kp H       &bhm LALT J  &bhm LEFT_CONTROL K  &bhm LGUI L  &bhm LSHIFT SEMI  &kp SQT
&td0      &kp Z          &kp X        &kp C                &kp V        &kp B          &kp N       &kp M        &kp COMMA            &kp DOT      &kp FSLH          &caps_word
                                      &mo 6                &mo 5        &lt 4 ENTER    &kp SPACE   &lt 1 SPACE  &kp RALT
            >;
        };

        nav_layer {
            display-name = "NAV";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   | 
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&trans  &trans     &trans     &trans     &key_repeat  &trans    &kp PG_UP    &kp HOME  &kp UP    &kp END    &kp BSPC   &kp DEL
&trans  &trans     &trans     &trans     &trans       &trans    &kp PG_DN    &kp LEFT  &kp DOWN  &kp RIGHT  &kp ENTER  &trans
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)    &trans    &key_repeat  &trans    &trans    &trans     &trans     &trans
                              &trans     &trans       &trans    &trans       &trans    &trans
            >;
        };

        mac_base_layer {
            display-name = "BASE2";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   | 
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB   &kp Q          &kp W                &kp E                &kp R        &kp T          &kp Y       &kp U        &kp I            &kp O                &kp P             &kp BSPC
&skq RALT  &bhm LSHIFT A  &bhm LEFT_CONTROL S  &bhm LEFT_COMMAND D  &bhm LALT F  &kp G          &kp H       &bhm LALT J  &bhm LEFT_GUI K  &bhm LEFT_CONTROL L  &bhm LSHIFT SEMI  &kp SQT
&td0      &kp Z          &kp X                &kp C                &kp V        &kp B          &kp N       &kp M        &kp COMMA        &kp DOT              &kp FSLH          &caps_word
                                              &mo 6                &mo 5        &lt 4 ENTER    &kp SPACE   &lt 3 SPACE  &kp RALT
            >;
        };

        mac_nav_layer {
            display-name = "NAV2";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   | 
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&trans  &trans     &trans     &trans     &key_repeat  &trans    &kp PG_UP    &kp HOME  &kp UP    &kp END    &kp BSPC   &kp DEL
&trans  &trans     &trans     &trans     &trans       &trans    &kp PG_DN    &kp LEFT  &kp DOWN  &kp RIGHT  &kp ENTER  &trans
&trans  &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)    &trans    &key_repeat  &trans    &trans    &trans     &trans     &trans
                              &trans     &trans       &trans    &trans       &trans    &trans
            >;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6     &kp N7   &kp N8  &kp N9  &kp N0     &kp EQUAL
&trans  &trans  &trans  &trans  &trans  &trans    &kp MINUS  &kp N4   &kp N5  &kp N6  &kp ASTRK  &kp MINUS
&trans  &trans  &trans  &trans  &trans  &trans    &kp UNDER  &kp N1   &kp N2  &kp N3  &kp SLASH  &kp PLUS
                        &trans  &trans  &trans    &kp COMMA  &kp DOT  &kp N0
            >;
        };

        symbol_layer {
            display-name = "SYMBOL";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp EXCL      &kp AT        &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&trans  &none         &none         &none     &none     &none        &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&trans  &out OUT_USB  &out OUT_BLE  &none     &none     &none        &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                    &trans    &trans    &kp SPACE    &kp RET    &trans     &trans
            >;
        };

        fn_layer {
            display-name = "FN";
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5     &kp F6       &kp F7      &kp F8  &kp F9  &kp F10          &kp F11
&trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10    &bootloader  &sys_reset  &trans  &trans  &kp PRINTSCREEN  &kp F12
&trans  &kp F11  &kp F12  &trans  &trans  &trans     &trans       &trans      &trans  &trans  &kp SCROLLLOCK   &kp PAUSE_BREAK
                          &trans  &trans  &trans     &trans       &to 1       &to 2
            >;
        };

        util_layer {
            display-name = "UTIL";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans           &trans           &trans          &trans             &sys_reset        &bootloader        &bootloader      &trans           &trans           &trans           &trans    &kp BSPC
&bt BT_CLR_ALL   &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_SEL 2       &bt BT_SEL 3      &trans             &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &kp HOME  &kp PG_UP
&bt BT_CLR       &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &ext_power EP_OFF  &ext_power EP_ON  &rgb_ug RGB_EFF    &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp END   &kp PG_DN
                                         &trans             &trans            &trans             &kp INS          &to 0          &to 2
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        util-layer {
            if-layers = <5 6>;
            then-layer = <7>;
        };
    };
};
